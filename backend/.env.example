# --- app database (users, conversations, messages, documents, saved analyses)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chanakya
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000
# Extra allowed origins (comma-separated) for LAN/devices, e.g. http://192.168.1.20:3000.
# Private-network origins (10/172.16-31/192.168/localhost, any port) are allowed by default.
CORS_ORIGINS=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SQL_ECHO=false

# --- LLM / embeddings
GROQ_API_KEY=your-groq-key
GROQ_MODEL_NAME=openai/gpt-oss-120b
GOOGLE_API_KEY=your-google-key
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
LLM_TIMEOUT_SECONDS=120
VECTOR_DIMENSION=3072

# --- vector store
VECTOR_STORE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chanakya
VECTOR_COLLECTION=vector_documents

# --- RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=5
MAX_UPLOAD_MB=20

# --- Analysis
# Every client database connects through this template ({name} = database name).
# Use a READ-ONLY login. The schema catalog builds automatically when a
# client is created. The prompt stays bounded (top-k tables, max columns).
ANALYSIS_DB_URL_TEMPLATE=postgresql+psycopg://analysis_ro:change-me@localhost:5432/{name}
ANALYSIS_TOP_TABLES=3
ANALYSIS_MAX_COLUMNS=0
ANALYSIS_SCHEMA_TABLE=schema_catalog
ANALYSIS_PAGE_SIZE=100
ANALYSIS_MAX_PAGE_SIZE=500
ANALYSIS_TIMEOUT_MS=15000
ANALYSIS_EXPORT_TIMEOUT_MS=300000
ANALYSIS_EXPORT_MAX_ROWS=1000000
ANALYSIS_TOKEN_MINUTES=120
